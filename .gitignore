node_modules/
out/

# The repository is public, so the code is public and our data is not.
# Every product file is ignored except the worked example, because a product
# file names a product and the words we are going after. Hush Log is already
# listed on the App Store, so it reveals nothing, and it keeps the repository
# runnable straight after a clone.
products/*.json
!products/hush-log.json

# Terraform state. The bootstrap keeps its state locally, because it creates the
# role that everything else assumes and so cannot use the remote backend. A copy
# lives in the hub at orgs/atlantic-blue/.secrets/proofmark-bootstrap.tfstate.
# Losing it orphans the role and the state bucket; import them back before
# applying again.
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
